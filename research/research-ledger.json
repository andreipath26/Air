{
  "version": "0.2",
  "hypotheses": [
    {
      "id": "H01",
      "name": "Generative intelligence encoding",
      "claim": "Compact reusable instructions may replace independently stored numerical relationships",
      "foundations": "Genetics, linguistics, program synthesis",
      "status": "untested"
    },
    {
      "id": "H02",
      "name": "Structural intelligence",
      "claim": "Connectivity, topology and executable relationships may encode learned information",
      "foundations": "Chemistry, graph theory, neuroscience",
      "status": "untested"
    },
    {
      "id": "H03",
      "name": "Intelligence compilation",
      "claim": "Optimal learning representation may differ from optimal inference representation",
      "foundations": "Compiler engineering, consolidation",
      "status": "untested"
    },
    {
      "id": "H04",
      "name": "Addressable intelligence",
      "claim": "Much knowledge may be retrieved instead of reconstructed",
      "foundations": "Databases, bioinformatics, associative memory",
      "status": "untested"
    },
    {
      "id": "H05",
      "name": "Modernised A.L.I.C.E.",
      "claim": "Modern semantic learning may overcome historical conversational architecture limitations",
      "foundations": "AIML, ChatScript, semantic parsing",
      "status": "untested"
    },
    {
      "id": "H06",
      "name": "Weightless intelligence",
      "claim": "Selected capabilities may execute through logic, binary patterns and lookup",
      "foundations": "Digital electronics, HDC, logic networks",
      "status": "untested"
    },
    {
      "id": "H07",
      "name": "Category-based selective activation",
      "claim": "SLM coordinates larger stores with small active working set",
      "foundations": "Information science, cognition",
      "status": "untested"
    },
    {
      "id": "H08",
      "name": "Task-centric inference",
      "claim": "Compute may scale with task complexity rather than total knowledge",
      "foundations": "Control theory, NARS, adaptive execution",
      "status": "untested"
    }
  ],
